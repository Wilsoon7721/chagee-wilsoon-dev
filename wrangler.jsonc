{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "chagee-wilsoon-dev",
    "compatibility_date": "2026-02-26",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "chagee-wilsoon-dev"
        }
    ],
    "observability": {
        "enabled": true
    },
    "routes": [
        {
            "pattern": "chagee.wilsoon.dev",
            "zone_name": "wilsoon.dev",
            "custom_domain": true
        }
    ],
    "images": {
        "binding": "IMAGES"
    },
    "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://xzggjlxocwclieepmzki.supabase.co",
        "NEXT_PUBLIC_BUCKET_NAME": "chagee-study",
        "WILSOON_CLIENT_ID": "cl_b5b00c1812fc5ad593e84131833506c5",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEg_0ZpmpUHki09g"
    }
}